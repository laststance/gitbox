# Test Environment Configuration
# This file is committed to git - contains only fake/test values
#
# For local overrides (e.g., E2E with real Supabase), use .env.test.local
# which is gitignored and takes precedence over this file.

# Supabase Configuration (mock values for unit tests)
NEXT_PUBLIC_SUPABASE_URL=https://test.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=test-anon-key
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key

# Site URL for testing
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MSW is disabled by default in unit tests (tests mock at module level)
NEXT_PUBLIC_ENABLE_MSW_MOCK=false
