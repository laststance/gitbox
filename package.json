{
  "name": "gitbox",
  "version": "0.3.1.3",
  "private": true,
  "type": "module",
  "description": "A web application for managing GitHub repositories in Kanban board format",
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "*.{js,ts,jsx,tsx,cjs,mjs}": [
      "eslint -c eslint.config.mjs --fix --concurrency=auto --max-warnings 0 --no-warn-ignored"
    ]
  },
  "scripts": {
    "dev": "next dev -p 3008",
    "dev:webpack": "next dev -p 3008 --webpack",
    "build": "next build",
    "start": "next start -p 3008",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --concurrency=auto --max-warnings 0",
    "lint:fix": "eslint . --fix --concurrency=auto --max-warnings 0",
    "lint:actions": "actionlint",
    "test": "vitest",
    "e2e": "playwright test",
    "e2e:parallel": "bash scripts/e2e-parallel.sh",
    "prepare": "husky",
    "prettier": "prettier --ignore-unknown --write .",
    "db:start": "cd supabase && . .env && supabase start",
    "db:stop": "cd supabase && supabase stop",
    "db:reset": "cd supabase && . .env && supabase db reset --local",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "validate:themes": "tsx scripts/validate-themes.ts",
    "validate": "concurrently -n build,lint,test,type -c blue,yellow,green,cyan \"pnpm run build\" \"pnpm run lint:fix\" \"vitest run\" \"pnpm run typecheck\""
  },
  "dependencies": {
    "@ariakit/react": "^0.4.34",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@laststance/redux-storage-middleware": "^0.3.2",
    "@platejs/autoformat": "^53.0.0",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/callout": "^53.0.0",
    "@platejs/code-block": "^53.0.0",
    "@platejs/combobox": "^53.0.0",
    "@platejs/date": "^53.0.0",
    "@platejs/dnd": "^53.1.0",
    "@platejs/floating": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/layout": "^53.0.0",
    "@platejs/link": "^53.3.1",
    "@platejs/list": "^53.1.3",
    "@platejs/math": "^53.0.0",
    "@platejs/media": "^53.1.4",
    "@platejs/resizable": "^53.0.0",
    "@platejs/selection": "^53.1.6",
    "@platejs/slash-command": "^53.0.0",
    "@platejs/suggestion": "^53.2.3",
    "@platejs/table": "^53.0.9",
    "@platejs/toc": "^53.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-toolbar": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@radix-ui/react-visually-hidden": "^1.2.7",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/nextjs": "^10.66.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.6",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-virtual": "^3.14.6",
    "@types/lodash": "^4.17.24",
    "@udecode/cn": "^52.3.4",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "destr": "^2.0.5",
    "framer-motion": "^12.42.2",
    "lodash": "^4.18.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.24.0",
    "next": "^16.2.10",
    "nextjs-toploader": "^3.9.17",
    "pino": "^10.3.1",
    "platejs": "^53.2.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "^9.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@laststance/react-next-eslint-plugin": "^2.2.0",
    "@next/eslint-plugin-next": "16.2.10",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.0",
    "@storybook/nextjs-vite": "^10.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "code-inspector-plugin": "^2.0.2",
    "concurrently": "^10.0.3",
    "eslint": "^10.7.0",
    "eslint-config-ts-prefixer": "^4.2.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "lint-staged": "^17.0.8",
    "monocart-reporter": "^2.12.2",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^2.0.7",
    "playwright": "^1.61.1",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prettier-plugin-tailwindcss-canonical-classes": "^0.1.5",
    "storybook": "^10.5.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
