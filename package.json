{
  "name": "gitbox",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A web application for managing GitHub repositories in Kanban board format",
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "*.{js,ts,jsx,tsx,cjs,mjs}": [
      "eslint -c eslint.config.mjs --fix --concurrency=auto --max-warnings 0 --no-warn-ignored"
    ]
  },
  "scripts": {
    "dev": "next dev -p 3008",
    "dev:webpack": "next dev -p 3008 --webpack",
    "build": "next build",
    "start": "next start -p 3008",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --concurrency=auto --max-warnings 0",
    "lint:fix": "eslint . --fix --concurrency=auto --max-warnings 0",
    "test": "vitest",
    "e2e": "playwright test",
    "e2e:parallel": "bash scripts/e2e-parallel.sh",
    "prepare": "husky",
    "prettier": "prettier --ignore-unknown --write .",
    "db:start": "cd supabase && . .env && supabase start",
    "db:stop": "cd supabase && supabase stop",
    "db:reset": "cd supabase && . .env && supabase db reset --local",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "validate:themes": "tsx scripts/validate-themes.ts",
    "validate": "concurrently -n build,lint,test,type -c blue,yellow,green,cyan \"pnpm run build\" \"pnpm run lint:fix\" \"vitest run\" \"pnpm run typecheck\""
  },
  "dependencies": {
    "@ariakit/react": "^0.4.26",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
