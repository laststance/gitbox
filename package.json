    "msw": "^2.13.4",
    "msw-storybook-addon": "^2.0.7",
    "playwright": "^1.59.1",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prettier-plugin-tailwindcss-canonical-classes": "^0.1.4",
    "storybook": "^10.3.5",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^4.2.3",
