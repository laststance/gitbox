{
  "name": "gitbox",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "description": "A web application for managing GitHub repositories in Kanban board format",
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "*.{js,ts,jsx,tsx,cjs,mjs}": [
      "eslint -c eslint.config.mjs --fix --concurrency=auto --max-warnings 0 --no-warn-ignored"
    ]
  },
  "scripts": {
    "dev": "next dev -p 3008",
    "dev:webpack": "next dev -p 3008 --webpack",
    "build": "next build",
    "start": "next start -p 3008",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --concurrency=auto --max-warnings 0",
    "lint:fix": "eslint . --fix --concurrency=auto --max-warnings 0",
    "lint:actions": "actionlint",
    "test": "vitest",
    "e2e": "playwright test",
    "e2e:parallel": "bash scripts/e2e-parallel.sh",
    "prepare": "husky",
    "prettier": "prettier --ignore-unknown --write .",
    "db:start": "cd supabase && . .env && supabase start",
    "db:stop": "cd supabase && supabase stop",
    "db:reset": "cd supabase && . .env && supabase db reset --local",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "validate:themes": "tsx scripts/validate-themes.ts",
    "validate": "concurrently -n build,lint,test,type -c blue,yellow,green,cyan \"pnpm run build\" \"pnpm run lint:fix\" \"vitest run\" \"pnpm run typecheck\""
  },
  "dependencies": {
    "@ariakit/react": "^0.4.40",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@laststance/redux-storage-middleware": "^0.4.0",
    "@platejs/autoformat": "^53.0.0",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/callout": "^53.0.0",
    "@platejs/code-block": "^53.0.0",
    "@platejs/combobox": "^53.0.0",
    "@platejs/date": "^53.0.0",
    "@platejs/dnd": "^53.3.8",
    "@platejs/floating": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/layout": "^53.0.0",
    "@platejs/link": "^53.3.5",
    "@platejs/list": "^53.3.13",
    "@platejs/math": "^53.3.12",
    "@platejs/media": "^53.1.4",
    "@platejs/resizable": "^53.0.0",
    "@platejs/selection": "^53.1.6",
    "@platejs/slash-command": "^53.0.0",
    "@platejs/suggestion": "^53.2.3",
    "@platejs/table": "^53.0.9",
    "@platejs/toc": "^53.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toolbar": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@reduxjs/toolkit": "^2.13.0",
    "@sentry/nextjs": "^11.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/lodash": "^4.17.25",
    "@udecode/cn": "^52.3.4",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
