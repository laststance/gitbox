# =============================================================================
# Local Development Setup
# =============================================================================
#
# 1. Start local Supabase (the script reads supabase/.env, so create that
#    file first: see step 3):
#    $ pnpm db:start
#
# 2. Get credentials:
#    $ supabase status -o env
#
# 3. Create GitHub OAuth App:
#    - Go to: https://github.com/settings/developers
#    - Application name: GitBox Local Dev
#    - Homepage URL: http://localhost:3008
#    - Authorization callback URL: http://127.0.0.1:54321/auth/v1/callback
#    - Save its client ID and secret in supabase/.env as GITHUB_CLIENT_ID and
#      GITHUB_CLIENT_SECRET
#
# =============================================================================

# Supabase LOCAL (from `supabase status -o env`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from_supabase_status>
SUPABASE_SERVICE_ROLE_KEY=<from_supabase_status>

# GitHub OAuth (from your GitHub OAuth App)
GITHUB_CLIENT_ID=<your_github_oauth_client_id>
GITHUB_CLIENT_SECRET=<your_github_oauth_client_secret>

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3008

# GitBox MCP endpoint (/api/mcp) — all three optional, but all three are
# required together: any one unset means the endpoint answers 503.
# Generate the bearer with `openssl rand -hex 32`.
# GITBOX_MCP_TOKEN=<openssl rand -hex 32>
# The Supabase user id (`board.user_id`) the endpoint operates as:
# GITBOX_MCP_OWNER_ID=<your_user_uuid>
# A GitHub PAT (classic `repo` scope, or fine-grained read access to the
# repositories it may add) — the MCP route has no cookie store:
# GITBOX_MCP_GITHUB_TOKEN=<github_pat>
